rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Services collection: Publicly readable by all visitors, editable by studio admin
    match /services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    // Config collection: Studio information (address, whatsapp, etc.)
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Bookings collection: Customers can create bookings, public can check slots, admin can update/manage
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Default deny for all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
